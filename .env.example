# Copy this file to .env. Never commit the populated .env file.
# Each developer uses their own credentials locally.

# Shared application, PayPal login, and database.
# Each presenter supplies their own PayPal app credentials on their laptop.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback
SUPABASE_URL=
# Use an sb_secret_ key or the legacy service_role JWT, not sb_publishable_.
SUPABASE_SERVICE_KEY=

# Victor - Stocks checkout and market services
PAYPAL_MERCHANT_EMAIL=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
FMP_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
FALLBACK_USD_SGD=1.2748

# Zavier - Crypto
# Add future keys with a ZAVIER_ or CRYPTO_ prefix.

# Ong Xuan - Other
# Add future keys with an ONG_XUAN_ or feature-specific prefix.
