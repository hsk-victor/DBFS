# Copy this file to .env. Never commit the populated .env file.
# Each developer uses their own credentials locally.

# Shared runtime and database.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Legacy Stocks callback kept for /api/auth compatibility.
PAYPAL_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback
SUPABASE_URL=
# Use an sb_secret_ key or the legacy service_role JWT, not sb_publishable_.
SUPABASE_SERVICE_KEY=

# Victor - Stocks auth, checkout and market services
VICTOR_PAYPAL_REDIRECT_URI=http://127.0.0.1:5000/api/victor/auth/callback
PAYPAL_MERCHANT_EMAIL=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
FMP_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
FALLBACK_USD_SGD=1.2748

# Zavier - Crypto auth and services
ZAVIER_PAYPAL_REDIRECT_URI=http://127.0.0.1:5000/api/zavier/auth/callback
EODHD_API_KEY=
COINGECKO_API_KEY=
NEWSAPI_API_KEY=
GNEWS_API_KEY=

# Ong Xuan - Forex auth and services
ONG_XUAN_PAYPAL_REDIRECT_URI=http://127.0.0.1:5000/api/ong-xuan/auth/callback
